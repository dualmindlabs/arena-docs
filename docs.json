{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "linden",
  "name": "DualMind Arena",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://dualmind.ai"
  },
  "favicon": "/favicon.svg",
  "colors": {
    "primary": "#0EA5E9",
    "light": "#38BDF8",
    "dark": "#0369A1",
    "background": {
      "light": "#F8FAFC",
      "dark": "#060B18"
    }
  },
  "fonts": {
    "heading": {
      "family": "Inter",
      "weight": 700
    },
    "body": {
      "family": "Inter",
      "weight": 400
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Arena",
        "href": "https://arena.dualmind.ai"
      },
      {
        "label": "Blog",
        "href": "https://dualmind.ai/blog"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Try Arena Free →",
      "href": "https://arena.dualmind.ai"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "welcome",
              "quickstart",
              "faq"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "concepts/how-dualmind-works",
              "concepts/model-comparison",
              "concepts/latency-measurement",
              "concepts/evaluation-philosophy"
            ]
          },
          {
            "group": "Platform",
            "pages": [
              "roadmap",
              "changelog"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Try the Arena",
          "href": "https://arena.dualmind.ai",
          "icon": "bolt"
        },
        {
          "anchor": "Leaderboard",
          "href": "https://arena.dualmind.ai/leaderboard",
          "icon": "chart-bar"
        },
        {
          "anchor": "LinkedIn",
          "href": "https://linkedin.com/company/dualmindlabs",
          "icon": "linkedin"
        }
      ]
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/dualmindai",
      "github": "https://github.com/dualmind-labs",
      "linkedin": "https://linkedin.com/company/dualmindlabs"
    }
  },
  "seo": {
    "indexing": "navigable"
  }
}