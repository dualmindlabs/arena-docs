{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "linden",
  "name": "DualMind Arena",
  "description": "Docs for DualMind Arena: blind, side-by-side AI model evaluation, the live ELO leaderboard and the Arena API.",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://docs.dualmindlab.tech"
  },
  "favicon": "/favicon.png",
  "colors": {
    "primary": "#0B7FA0",
    "light": "#00D9FF",
    "dark": "#0B7FA0"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#0F1115"
    }
  },
  "fonts": {
    "heading": {
      "family": "Bricolage Grotesque",
      "weight": 600
    },
    "body": {
      "family": "Bricolage Grotesque",
      "weight": 400
    }
  },
  "icons": {
    "library": "lucide"
  },
  "appearance": {
    "default": "system"
  },
  "styling": {
    "eyebrows": "section",
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "vesper"
      }
    }
  },
  "thumbnails": {
    "preset": "headline",
    "appearance": "dark",
    "surface": "neutral",
    "background": "/images/thumbnail-bg.jpg",
    "eyebrow": {
      "source": "group",
      "style": "pill",
      "color": "#00D9FF"
    }
  },
  "banner": {
    "content": "**New:** the DualMind API reference is live in beta. [Run your first battle from code →](/api-reference/guides/run-a-battle)",
    "dismissible": true
  },
  "navbar": {
    "links": [
      {
        "label": "Leaderboard",
        "href": "https://arena.dualmindlab.tech/leaderboard/",
        "icon": "trophy"
      },
      {
        "label": "Status",
        "href": "/status",
        "icon": "activity"
      },
      {
        "label": "dualmindlab.tech",
        "href": "https://dualmindlab.tech",
        "icon": "globe"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open the Arena",
      "href": "https://arena.dualmindlab.tech"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "icon": "book-open",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "welcome",
              "quickstart",
              "faq"
            ],
            "icon": "rocket"
          },
          {
            "group": "Using the Arena",
            "pages": [
              "concepts/model-comparison",
              "concepts/voting",
              "concepts/leaderboard",
              "concepts/threads",
              "concepts/models-and-providers"
            ],
            "icon": "swords"
          },
          {
            "group": "How it works",
            "pages": [
              "concepts/how-dualmind-works",
              "concepts/latency-measurement",
              "concepts/evaluation-philosophy"
            ],
            "icon": "workflow"
          },
          {
            "group": "Resources",
            "icon": "library",
            "pages": [
              "glossary",
              "for-agents"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "icon": "code",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction",
              "api-reference/authentication",
              "api-reference/errors",
              "status"
            ],
            "icon": "book-open"
          },
          {
            "group": "Tutorials",
            "pages": [
              "api-reference/guides/run-a-battle",
              "api-reference/guides/streaming"
            ],
            "icon": "graduation-cap",
            "tag": "New"
          },
          {
            "group": "Arena",
            "pages": [
              "api-reference/chat/dual-chat",
              "api-reference/chat/single-chat",
              "api-reference/chat/streaming"
            ],
            "icon": "zap"
          },
          {
            "group": "Voting & leaderboard",
            "pages": [
              "api-reference/voting/submit-vote",
              "api-reference/voting/get-stats"
            ],
            "icon": "trophy"
          },
          {
            "group": "Models",
            "pages": [
              "api-reference/models/list-models"
            ],
            "icon": "cpu"
          },
          {
            "group": "Threads",
            "pages": [
              "api-reference/threads/list-threads",
              "api-reference/threads/create-thread",
              "api-reference/threads/get-thread",
              "api-reference/threads/get-messages",
              "api-reference/threads/update-thread",
              "api-reference/threads/share-thread",
              "api-reference/threads/delete-thread"
            ],
            "icon": "messages-square"
          },
          {
            "group": "Utilities",
            "pages": [
              "api-reference/utilities/health",
              "api-reference/utilities/feature-flags"
            ],
            "icon": "wrench"
          }
        ]
      },
      {
        "tab": "Changelog",
        "icon": "history",
        "groups": [
          {
            "group": "Product",
            "pages": [
              "changelog",
              "roadmap"
            ],
            "icon": "newspaper"
          }
        ],
        "align": "end"
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Open the Arena",
          "href": "https://arena.dualmindlab.tech",
          "icon": "swords"
        },
        {
          "anchor": "Leaderboard",
          "href": "https://arena.dualmindlab.tech/leaderboard/",
          "icon": "trophy"
        },
        {
          "anchor": "API status",
          "href": "/status",
          "icon": "activity"
        }
      ]
    }
  },
  "api": {
    "openapi": "api-reference/openapi.json",
    "playground": {
      "display": "interactive"
    },
    "params": {
      "expanded": "closed"
    },
    "examples": {
      "languages": [
        "bash",
        "python",
        "javascript",
        "typescript",
        "go",
        "csharp",
        "java"
      ],
      "defaults": "required",
      "prefill": true
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "download-spec",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "add-mcp",
      "cursor",
      "vscode",
      {
        "title": "Report a docs issue",
        "description": "Email the DualMind team about this page",
        "icon": "message-square-warning",
        "href": {
          "base": "mailto:support@dualmindlab.tech",
          "query": [
            {
              "key": "subject",
              "value": "Docs issue: $path"
            }
          ]
        }
      }
    ]
  },
  "search": {
    "prompt": "Search battles, voting, endpoints…"
  },
  "metadata": {
    "timestamp": true
  },
  "markdown": {
    "instructions": [
      "DualMind Arena API base URL: https://api.dualmindlab.tech. Public endpoints only; admin routes are not part of this API.",
      "Authenticate with the access token from an Arena session (a Supabase JWT) as `Authorization: Bearer <token>`. There are no API keys yet; never invent one.",
      "For battles call POST /api/arena/dualchat, then vote with POST /api/arena/model-vote using the returned comparisonId. Keep model names hidden from voters until they vote.",
      "GET /api/arena/model-stats (leaderboard) and GET /health need no token."
    ]
  },
  "variables": {
    "apiBase": "https://api.dualmindlab.tech",
    "arenaUrl": "https://arena.dualmindlab.tech",
    "supportEmail": "support@dualmindlab.tech"
  },
  "footer": {
    "socials": {
      "website": "https://dualmindlab.tech",
      "github": "https://github.com/dualmindlabs"
    },
    "links": [
      {
        "header": "Product",
        "items": [
          {
            "label": "Arena",
            "href": "https://arena.dualmindlab.tech"
          },
          {
            "label": "Leaderboard",
            "href": "https://arena.dualmindlab.tech/leaderboard/"
          },
          {
            "label": "Changelog",
            "href": "/changelog"
          }
        ]
      },
      {
        "header": "Developers",
        "items": [
          {
            "label": "API reference",
            "href": "/api-reference/introduction"
          },
          {
            "label": "Run a battle",
            "href": "/api-reference/guides/run-a-battle"
          },
          {
            "label": "API status",
            "href": "/status"
          }
        ]
      },
      {
        "header": "Resources",
        "items": [
          {
            "label": "Glossary",
            "href": "/glossary"
          },
          {
            "label": "Editors & agents",
            "href": "/for-agents"
          },
          {
            "label": "Changelog RSS",
            "href": "https://docs.dualmindlab.tech/changelog/rss.xml"
          }
        ]
      },
      {
        "header": "Company",
        "items": [
          {
            "label": "DualMind Labs",
            "href": "https://dualmindlab.tech"
          },
          {
            "label": "Contact",
            "href": "https://dualmindlab.tech/contact"
          },
          {
            "label": "Privacy",
            "href": "https://dualmindlab.tech/privacy"
          }
        ]
      }
    ]
  },
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "og:site_name": "DualMind Arena Docs",
      "og:type": "website",
      "twitter:card": "summary_large_image",
      "theme-color": "#0F1115"
    },
    "organization": {
      "name": "DualMind Labs",
      "url": "https://dualmindlab.tech",
      "logo": "https://dualmindlab.tech/icon.png",
      "sameAs": [
        "https://github.com/dualmindlabs",
        "https://arena.dualmindlab.tech"
      ]
    }
  },
  "redirects": [
    {
      "source": "/api-reference/users/sync-user",
      "destination": "/api-reference/authentication"
    },
    {
      "source": "/api-reference/utilities/speech",
      "destination": "/api-reference/introduction"
    },
    {
      "source": "/introduction",
      "destination": "/welcome"
    },
    {
      "source": "/docs",
      "destination": "/welcome"
    },
    {
      "source": "/api",
      "destination": "/api-reference/introduction"
    },
    {
      "source": "/leaderboard",
      "destination": "/concepts/leaderboard"
    },
    {
      "source": "/concepts/threads-and-sharing",
      "destination": "/concepts/threads"
    },
    {
      "source": "/api-reference/status",
      "destination": "/status"
    },
    {
      "source": "/mcp-server",
      "destination": "/for-agents"
    },
    {
      "source": "/use-with-ai",
      "destination": "/for-agents"
    }
  ],
  "errors": {
    "404": {
      "redirect": false,
      "title": "This page lost the vote",
      "description": "We couldn't find that page. Try search (⌘K), head back to the [docs home](/welcome), or jump to the [API reference](/api-reference/introduction)."
    }
  }
}
